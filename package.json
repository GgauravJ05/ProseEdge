{
  "name": "prose-edge",
  "version": "0.1.1",
  "private": true,
  "description": "On-device text formatting with a measured accessibility and engagement model",
  "license": "AGPL-3.0-or-later",
  "author": "Gaurav Jadhav <gauravmakarandjadhav@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "next dev",
    "build": "next build",
    "e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "fixtures:unicode": "bash scripts/fetch-unicode-fixture.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.9.0",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vercel": "59.15.1",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
